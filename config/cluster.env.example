# Copy this file to config/cluster.env on both Sparks and edit the values.
# Never commit config/cluster.env to Git.
#
#   cp config/cluster.env.example config/cluster.env
#   chmod 600 config/cluster.env
#
# On Spark 1 set ROLE=head. On Spark 2 set ROLE=worker.
# All other values should match on both systems.

# Role of the current Spark: head (Spark 1) or worker (Spark 2)
export ROLE=head

# QSFP / ConnectX-7 interface used for Ray + NCCL traffic
# Confirm with: ibdev2netdev ; ip -4 -o addr show
export MN_IF_NAME=enp1s0f1np1

# QSFP IPs of the two Sparks (dedicated point-to-point network)
export HEAD_QSFP_IP=192.168.100.10
export WORKER_QSFP_IP=192.168.100.11

# Normal LAN IP of Spark 1 (used by LiteLLM to reach vLLM)
export HEAD_LAN_IP=192.168.1.50

# LAN IP of the LiteLLM machine (used for UFW allow rule)
export LITELLM_IP=192.168.1.60

# Local paths
export WORKDIR="$HOME/dgx-qwen3"
export HF_CACHE="$HOME/.cache/huggingface"
export LOG_DIR="$HOME/dgx-qwen3/logs"

# vLLM container and model
export VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05-py3
export MODEL_ID=RedHatAI/Qwen3-235B-A22B-Instruct-2507-NVFP4
export SERVED_MODEL_NAME=qwen3-235b-a22b
export VLLM_PORT=8000

# Conservative bring-up profile (matches Red Hat TP=2 evaluation profile)
export GPU_MEMORY_UTILIZATION=0.70
export MAX_MODEL_LEN=4096
export MAX_NUM_SEQS=1
export MAX_NUM_BATCHED_TOKENS=4096

# Optional: tool calling (leave disabled until baseline chat passes)
export ENABLE_TOOLS=false
export TOOL_CALL_PARSER=hermes

# Secrets — replace before use, never commit
export HF_TOKEN=hf_REPLACE_ME
# Generate once on Spark 1 with: openssl rand -hex 32
export VLLM_API_KEY=REPLACE_ME
